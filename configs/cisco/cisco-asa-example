!--- SERVICE OBJECTS AND GROUPS
object-group service Web-Services tcp
  service-object eq 80
  service-object eq 443
object-group service Infra-Services tcp
  service-object eq 53
  service-object eq 123
  service-object eq 161
object-group service Custom-Multi tcp
  service-object eq 10001
object-group service Custom-Multi-UDP udp
  service-object eq 20001
!
!--- ACLs for ALPHA (apply to alpha_lobby inbound, as in FortiGate rules)
access-list alpha_lobby_access extended permit tcp object alpha_lobby_net object alpha_dest1_host1 eq 80
access-list alpha_lobby_access extended permit tcp object alpha_lobby_net object-group alpha_dest1_grp object-group Web-Services
access-list alpha_lobby_access extended permit tcp object alpha_lobby_net object-group alpha_dest2_grp object-group Infra-Services
access-list alpha_lobby_access extended permit tcp object alpha_lobby_net object alpha_dest3_host1 eq 10001
access-list alpha_lobby_access extended permit udp object alpha_lobby_net object alpha_dest3_host1 eq 20001
access-list alpha_lobby_access extended permit ip object alpha_lobby_net object-group alpha_destgrp_all
access-group alpha_lobby_access in interface alpha_lobby
!
