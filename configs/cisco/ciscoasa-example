! Basic ASA Configuration
hostname ASA1
interface Vlan1
 nameif inside
 security-level 100
 ip address 192.168.1.1 255.255.255.0
!
interface Vlan2
 nameif outside
 security-level 0
 ip address dhcp setroute
!
interface Vlan3
 nameif DMZ
 security-level 50
 ip address 192.168.2.1 255.255.255.0
!
object network obj_websrv
 host 192.168.2.10
 nat (DMZ,outside) static 203.0.113.10
!
access-list outside_access_in extended permit tcp any object obj_websrv eq 80
access-group outside_access_in in interface outside
