! ASA example aligned with FortiGate sample rules
!
object network HOST_A
 host 10.1.1.1
object network HOST_B
 host 10.1.1.2
object network DB
 host 10.2.2.10
object network WEB
 host 10.2.2.20
!
object-group service SQLCL
 service-object tcp eq 1433
 service-object udp eq 1434
object-group service HTTPS
 service-object tcp eq 443
!
access-list OUT extended permit tcp object HOST_A object DB eq 1433
access-list OUT extended permit tcp object HOST_B object DB eq 1433
access-list OUT extended permit tcp object HOST_A object WEB eq 443
access-list OUT extended deny ip any object WEB
