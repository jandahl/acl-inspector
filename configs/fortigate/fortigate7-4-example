# ========== VDOM Creation ==========
config vdom
    edit "Alpha"
    next
    edit "Bravo"
    next
    edit "Charlie"
    next
end

# ========== Interface Assignments ==========
config global
    config system interface
        # Alpha
        edit "lobby"
            set vdom "Alpha"
            set ip 10.0.1.1/24
        next
        edit "dest1"
            set vdom "Alpha"
            set ip 10.1.1.1/24
        next
        edit "dest2"
            set vdom "Alpha"
            set ip 10.1.2.1/24
        next
        edit "dest3"
            set vdom "Alpha"
            set ip 10.1.3.1/24
        next
        edit "dest4"
            set vdom "Alpha"
            set ip 10.1.4.1/24
        next
        # Bravo
        edit "lobby"
            set vdom "Bravo"
            set ip 10.0.2.1/24
        next
        edit "dest1"
            set vdom "Bravo"
            set ip 10.2.1.1/24
        next
        edit "dest2"
            set vdom "Bravo"
            set ip 10.2.2.1/24
        next
        edit "dest3"
            set vdom "Bravo"
            set ip 10.2.3.1/24
        next
        edit "dest4"
            set vdom "Bravo"
            set ip 10.2.4.1/24
        next
        # Charlie
        edit "lobby"
            set vdom "Charlie"
            set ip 10.0.3.1/24
        next
        edit "dest1"
            set vdom "Charlie"
            set ip 10.3.1.1/24
        next
        edit "dest2"
            set vdom "Charlie"
            set ip 10.3.2.1/24
        next
        edit "dest3"
