# FortiGate example aligned with ASA sample rules

config vdom
    edit root
        # Addresses
        config firewall address
            edit "HOST_A"
                set subnet 10.1.1.1 255.255.255.255
            next
            edit "HOST_B"
                set subnet 10.1.1.2 255.255.255.255
            next
            edit "DB"
                set subnet 10.2.2.10 255.255.255.255
            next
            edit "WEB"
                set subnet 10.2.2.20 255.255.255.255
            next
        end

        # Services
        config firewall service custom
            edit "SQLCL-TCP"
                set tcp-portrange 1433-1433
            next
            edit "SQLCL-UDP"
                set udp-portrange 1434-1434
            next
            edit "HTTPS"
                set tcp-portrange 443-443
            next
        end

        # Policies
        config firewall policy
            edit 1
                set name "HOST_A_to_DB_1433"
                set action accept
                set srcaddr "HOST_A"
                set dstaddr "DB"
                set service "SQLCL-TCP"
            next
            edit 2
                set name "HOST_B_to_DB_1433"
                set action accept
                set srcaddr "HOST_B"
                set dstaddr "DB"
                set service "SQLCL-TCP"
            next
            edit 3
                set name "HOST_A_to_WEB_443"
                set action accept
                set srcaddr "HOST_A"
                set dstaddr "WEB"
                set service "HTTPS"
            next
            edit 4
                set name "Deny_to_WEB"
                set action deny
                set srcaddr "all"
                set dstaddr "WEB"
                set service "ALL"
            next
        end
    next
end

